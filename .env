APP_ENV=production
APP_DEBUG=false
APP_KEY=jikan-deploy-key-2024
CACHE_DRIVER=mongodb
CACHE_METHOD=legacy
CACHE_DEFAULT_EXPIRE=86400
CACHE_PREFIX=jikan
MONGODB_URI="mongodb+srv://jikan_user:JikanDeploy2024!secure@aniocean.y930vxk.mongodb.net/jikan?retryWrites=true&w=majority"
MONGODB_DATABASE=jikan
MONGODB_CACHE_COLLECTION=cache
GITHUB_REPORTING=false
# --- Dynamic cache storage guard (t151: keep M0 512MB cluster below its cap) ---
# Max lifetime for Cache::forever() entries (was 10 years -> unbounded growth)
CACHE_MAX_LIFETIME=604800
# CacheGc: evict when cache collection logical size crosses HIGH (MB) down to TARGET (MB)
CACHE_GC_HIGH_MB=350
CACHE_GC_TARGET_MB=220
# CacheGc: delete payload/ttl docs untouched for N days (LRU retention)
CACHE_GC_RETENTION_DAYS=7
# CacheGc: min seconds between automatic runs + per-run delete time budget
CACHE_GC_MIN_INTERVAL=900
CACHE_GC_TIME_BUDGET=8
